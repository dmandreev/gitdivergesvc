# GitDiverge API base URL
VITE_API_BASE=http://localhost:8080

# OIDC / Keycloak configuration
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/myrealm
VITE_OIDC_CLIENT_ID=react-spa

# Enable/disable authentication
USE_AUTH=true

# Jira server address for ticket linking (e.g. http://jira.addr.localurl/projects)
# Leave empty to disable Jira ticket linking
VITE_JIRA_SERVER_ADDR=